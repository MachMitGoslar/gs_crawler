# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed.

# === Wochenmarkt / HSP Markets API ===
# OAuth client credentials (client_credentials flow)
# Token endpoint: https://backend.goslar-id.ceconsoft.de/connect/token
WOCHENMARKT_CLIENT_ID=
WOCHENMARKT_CLIENT_SECRET=

# === Freiwilligenagentur / API Key ===
FREIWILLIGEN_AGENTUR_API_KEY=

# === Container-User (Härtung, siehe docs/HARDENING.md) ===
# UID/GID des Hosting-Users (Besitzer von httpdocs/crawler); die Container laufen mit dieser Kennung.
# Ermitteln mit: id -u && id -g
CRAWLER_UID=1000
CRAWLER_GID=1000
